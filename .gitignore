# Build output.
/forge
/bin/

# Coverage and profiling artefacts. Anchored to the module root so that test
# fixtures keep their extensions.
/cover.out
/coverage.out
/*.prof
*.test

# Editor and OS noise.
.DS_Store
.idea/
.vscode/

# A bare "tags" is the usual global ignore for ctags output, and it also matches
# this module's internal/tags package directory. Re-include it here.
/tags
!internal/tags/
